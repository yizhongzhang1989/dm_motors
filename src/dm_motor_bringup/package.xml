<?xml version="1.0"?>
<package format="3">
  <name>dm_motor_bringup</name>
  <version>0.1.0</version>
  <description>System bringup launch files for CAN buses, Damiao motors and dashboards.</description>
  <maintainer email="yizhongzhang1989@users.noreply.github.com">yizhongzhang1989</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>can_bus</exec_depend>
  <exec_depend>can_bus_dashboard</exec_depend>
  <exec_depend>dm_motor_control</exec_depend>
  <exec_depend>dm_motor_dashboard</exec_depend>
  <exec_depend>dm_motor_lead_follow</exec_depend>
  <exec_depend>dm_motor_lead_follow_dashboard</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
