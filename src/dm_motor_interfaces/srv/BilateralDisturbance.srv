# One explicit pulse in joint coordinates. Only the current guarded ACTIVE session may request it.
# Requests expire after valid_for seconds (0 < valid_for <= 0.5); accepted stamps must increase.
std_msgs/Header header
float64 valid_for
string session
# 0 = motor_a, 1 = motor_b. A busy pulse is rejected, never queued or extended.
uint8 axis
# Finite, nonzero torque in [-0.3, 0.3] Nm; 0 < duration <= 0.2 seconds.
float64 torque
float64 duration
---
bool success
string message
# Monotonically increasing within this controller process; zero on rejection.
uint64 disturbance_id
